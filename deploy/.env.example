# copy this file to .env in the same folder and fill it in, .env is kept out of git
# make each token with  python -c "import secrets; print(secrets.token_urlsafe(32))"

# the address people will open, pointing at the server's public ip
# with no domain of your own, 1-2-3-4.sslip.io works for a server at 1.2.3.4
NEUSE_DOMAIN=neuse.example.org

# coordinator token, it opens the map and reports
NEUSE_CC_TOKEN=change-me

# one token per field unit, they can only send for that unit
NEUSE_CC_UNIT_TOKENS=unit-1=change-me-1,unit-2=change-me-2,unit-3=change-me-3

# rds for mysql, the private address from the rds console
# leave empty to keep an sqlite file on the server instead
# write @ in the password as %40 and : as %3A
NEUSE_CC_DATABASE_URL=mysql://neuse:change-me@192.168.0.10:3306/neuse

# optional language model for situation reports, from modelarts studio
# the base address ends before /chat/completions
NEUSE_LLM_URL=
NEUSE_LLM_KEY=
NEUSE_LLM_MODEL=

# the address coordinators open, added to alert texts
NEUSE_PUBLIC_URL=https://neuse.example.org

# optional text alerts through huawei cloud smn, see docs/DEPLOY.md step 9
# without them alerts are still shown on the map
NEUSE_SMN_TOPIC_URN=
NEUSE_SMN_REGION=af-south-1
NEUSE_SMN_PROJECT_ID=
CLOUD_SDK_AK=
CLOUD_SDK_SK=
# when to alert, these are the defaults
NEUSE_ALERT_MIN_SIGHTINGS=3
NEUSE_ALERT_MIN_CONFIDENCE=0.8
NEUSE_ALERT_WINDOW_MINUTES=10
NEUSE_ALERT_QUIET_MINUTES=30
NEUSE_ALERT_MAX_AGE_MINUTES=120

# optional map background, the public openstreetmap tiles are used when empty
NEUSE_TILE_URL=
NEUSE_TILE_CREDIT=
